# Optional local or hosted MLflow tracking configuration.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
DAGSHUB_REPO_OWNER=your-account
DAGSHUB_REPO_NAME=your-repository
MLFLOW_TRACKING_USERNAME=replace-with-username
MLFLOW_TRACKING_PASSWORD=replace-with-token
# AWS credentials, when using AWS deployment, belong in GitHub Actions secrets.
